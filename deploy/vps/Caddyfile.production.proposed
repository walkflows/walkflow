# PROPOSED (Phase 2, NOT applied): production site block for the WALKFLOW website on the VPS.
# Apply only at cutover, after the DNS records for walkflow.tech / www.walkflow.tech point at this server.
# Security headers (CSP, HSTS, ...) come from the app (next.config.ts) and are passed through unchanged.
# Caddy obtains public Let's Encrypt certificates automatically and redirects HTTP to HTTPS.
# Both hostnames serve the site directly, exactly as on Vercel today (canonical URLs are already walkflow.tech).
walkflow.tech, www.walkflow.tech {
	header -Server
	request_body {
		max_size 64KB
	}
	reverse_proxy 127.0.0.1:3101 {
		# Overwrite (never append) with the real connecting address; the app trusts only this header.
		header_up X-WF-Client-IP {remote_host}
		header_up -X-Forwarded-For
		header_up -X-Real-IP
	}
}
