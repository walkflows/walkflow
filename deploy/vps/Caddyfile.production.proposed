# Production site blocks for the WALKFLOW website on the VPS (as applied on 12 October 2026, plus the www redirect below).
# Security headers (CSP, HSTS, ...) come from the app (next.config.ts) and are passed through unchanged.
# Caddy obtains public Let's Encrypt certificates automatically and redirects HTTP to HTTPS.

# https://walkflow.tech is the preferred address. www answers only with a permanent redirect that keeps the path
# and the query string (308 = permanent, like 301, but a POST stays a POST). It still needs its own certificate,
# which Caddy keeps renewing automatically.
www.walkflow.tech {
	header Strict-Transport-Security "max-age=63072000"
	redir https://walkflow.tech{uri} 308
}

walkflow.tech {
	header -Server
	# The app answers 413 itself for bodies over its own limits (8 KB enquiry, 2 KB chat). Caddy only guards against
	# huge uploads: a declared size of 1,000,000+ bytes gets 413 here; undeclared (chunked) bodies are capped at 1 MB.
	@hugebody header_regexp Content-Length ^[0-9]{7,}$
	respond @hugebody 413
	request_body {
		max_size 1MB
	}
	reverse_proxy 127.0.0.1:3101 {
		# Overwrite (never append) with the real connecting address; the app trusts only this header.
		header_up X-WF-Client-IP {remote_host}
		header_up -X-Forwarded-For
		header_up -X-Real-IP
	}
}
