[Unit]
Description=WALKFLOW automatic production release (pull from GitHub master, build, smoke-test, roll back on failure)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/walkflow-web/auto-release.sh
# A release (build ~1.5 min + deploy + smoke test) must finish well inside this.
TimeoutStartSec=25min
Nice=10
# No login account exists for this job: it runs from systemd as root because release.sh must read the root-only web.env
# files and use Docker. It listens on no port and holds no remote credential. Hardening below limits what it can touch.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# ProtectHome hides /root, and Docker (client, buildx, compose) needs a writable config directory ("mkdir /root/.docker:
# read-only file system" broke the first release). Give it a private one that systemd creates for this service only,
# instead of loosening ProtectHome. If you change these lines, keep the self-test in install-auto-release.sh in step.
StateDirectory=walkflow-autorelease
StateDirectoryMode=0700
Environment=HOME=/var/lib/walkflow-autorelease
Environment=DOCKER_CONFIG=/var/lib/walkflow-autorelease/docker
