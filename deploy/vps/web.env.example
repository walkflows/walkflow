# Copy to /opt/walkflow-web/<env>/web.env on the VPS, chmod 600. Never commit the real file.
# Production n8n webhook (self-hosted). NEVER the retired n8n Cloud copy or a /webhook-test/ URL.
N8N_ENQUIRY_WEBHOOK_URL=https://<your-production-n8n-host>/webhook/walkflow-business/enquiry
N8N_ENQUIRY_SECRET=
N8N_ENQUIRY_TIMEOUT_MS=20000
# Public WhatsApp link (also needed at build time by build.sh via build.env).
NEXT_PUBLIC_WHATSAPP_URL=
# Trust ONLY the header Caddy overwrites with the real client address.
CLIENT_IP_HEADER=x-wf-client-ip
# Private Redis rate-limit store (same password in REDIS_URL).
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
