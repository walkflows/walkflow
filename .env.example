# Supabase (enquiry storage) - leave unset in development until the project is connected
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostHog (consent-aware analytics) - leave unset until the project is connected
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Real Estate demo — Connected Mode (n8n + Supabase). NOT used yet: the demo
# at /demos/real-estate runs entirely in Preview Mode regardless of these
# values. Leave unset until n8n and Supabase are both configured and tested
# end to end — see docs/real-estate-demo-integration.md and
# src/lib/real-estate-demo/contract.ts before setting these.
N8N_REAL_ESTATE_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Home Services demo — Connected Mode (n8n + Supabase). NOT used yet: the
# demo at /demos/home-services runs entirely in Preview Mode regardless of
# these values. Leave unset until n8n and Supabase are both configured and
# tested end to end — see docs/home-services-demo-integration.md and
# src/lib/home-services-demo/contract.ts before setting these. Can reuse
# the same N8N_WEBHOOK_SECRET above if both demos share one n8n instance.
N8N_HOME_SERVICES_WEBHOOK_URL=

# Clinics demo — Connected Mode (n8n + Supabase). NOT used yet: the demo at
# /demos/clinics runs entirely in Preview Mode regardless of these values.
# Leave unset until n8n and Supabase are both configured and tested end to
# end — see docs/clinics-demo-integration.md and
# src/lib/clinics-demo/contract.ts before setting these. Can reuse the
# same N8N_WEBHOOK_SECRET above if all three demos share one n8n instance.
N8N_CLINICS_WEBHOOK_URL=

# Consulting demo — Connected Mode (n8n + Supabase). NOT used yet: the demo
# at /demos/consulting runs entirely in Preview Mode regardless of these
# values. Leave unset until n8n and Supabase are both configured and
# tested end to end — see docs/consulting-demo-integration.md and
# src/lib/consulting-demo/contract.ts before setting these. Can reuse the
# same N8N_WEBHOOK_SECRET above if all four demos share one n8n instance.
N8N_CONSULTING_WEBHOOK_URL=

# WhatsApp floating button. Leave empty until the WhatsApp link is confirmed;
# the button is hidden while this is unset. Must start with https://wa.me/ or
# https://api.whatsapp.com/. Public value: it is bundled into the site, so
# redeploy after changing it. Example format: https://wa.me/<country code + number>
NEXT_PUBLIC_WHATSAPP_URL=
